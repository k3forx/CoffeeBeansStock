# Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=coffee_user
DB_PASSWORD=coffee_pass
DB_NAME=coffee_stock
DB_SSLMODE=disable

# JWT (REQUIRED)
# Must be at least 32 characters with mixed character types (uppercase, lowercase, digits, symbols)
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Logging
LOG_LEVEL=info
